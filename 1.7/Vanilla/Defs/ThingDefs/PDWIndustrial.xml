<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Multi-Caliber/Calibre PDW / Gepard -->
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>PDWorks_MultiCalPDW</defName>
        <label>Multi-caliber PDW</label>
        <description>An exotic industrial-era PDW sharing some design familiarity with an antiquated service rifle, capable of firing a wide range of ammunition without the need to change any parts.\n\n Often issued as a weapon to aircrews and vehicle crews alike, as the option of scavenging any pistol ammunition off the enemy gives it high utility in emergency situations.</description>

        <graphicData>
            <texPath>Weapons/PDWorks_Gepard</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_Rifle</soundInteract>
        <weaponClasses>
            <li>RangedLight</li>
        </weaponClasses>
        <weaponTags>
            <li>ShortShots</li>
        </weaponTags>
        <statBases>
            <WorkToMake>30000</WorkToMake>
            <Mass>2.5</Mass>
            <AccuracyTouch>0.85</AccuracyTouch>
            <AccuracyShort>0.78</AccuracyShort>
            <AccuracyMedium>0.35</AccuracyMedium>
            <AccuracyLong>0.2</AccuracyLong>
            <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>30</Steel>
            <Chemfuel>5</Chemfuel>
            <WoodLog>5</WoodLog>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <recipeMaker>
			<researchPrerequisite>GasOperation</researchPrerequisite>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>436</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_Autopistol</defaultProjectile>
                <warmupTime>0.5</warmupTime>
                <range>27</range>
                <burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundCast>Shot_MachinePistol</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>handle</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>muzzle</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>10</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.8,0.8)</drawSize>
				<offsets>
					<li>(0.53,0.09)</li>
				</offsets>
			</li>
		</modExtensions>
    </ThingDef>

	<!-- Bullpup micro-rifle / WLVRN Micron 7.62x51 -->
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>PDWorks_BullpupMicroRifle</defName>
        <label>Bullpup micro-rifle</label>
        <description>A very compact modular bullpup rifle in a full-power rifle caliber. Boasts compact design effective at close to medium ranges and a good fire rate, at expense of total range and accuracy through a shorter barrel.</description>

        <graphicData>
            <texPath>Weapons/PDWorks_Micron_762</texPath>
            <graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.9,0.9)</drawSize>
        </graphicData>
        <soundInteract>Interact_Rifle</soundInteract>
        <weaponClasses>
            <li>RangedLight</li>
        </weaponClasses>
        <weaponTags>
            <li>IndustrialGunAdvanced</li>
			<li>AssaultRifle</li>
        </weaponTags>
        <statBases>
            <WorkToMake>40000</WorkToMake>
            <Mass>3.33</Mass>
            <AccuracyTouch>0.70</AccuracyTouch>
            <AccuracyShort>0.81</AccuracyShort>
            <AccuracyMedium>0.65</AccuracyMedium>
            <AccuracyLong>0.35</AccuracyLong>
            <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>40</Steel>
            <Chemfuel>10</Chemfuel>
            <ComponentIndustrial>8</ComponentIndustrial>
        </costList>
        <recipeMaker>
			<researchPrerequisite>PrecisionRifling</researchPrerequisite>
            <skillRequirements>
                <Crafting>7</Crafting>
            </skillRequirements>
            <displayPriority>436</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_BoltActionRifle</defaultProjectile>
                <warmupTime>1.0</warmupTime>
                <range>29</range>
                <burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundCast>Shot_AssaultRifle</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>15</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>muzzle</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>10</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(1.5,1.5)</drawSize>
				<offsets>
					<li>(0.54,0.11)</li>
				</offsets>
			</li>
		</modExtensions>
    </ThingDef>

	<!-- Crude compact grenade launcher / RGM-40 -->
	<ThingDef ParentName="BaseBullet">
    <defName>CZAPDWorks_Bullet_GrenadeLauncher</defName>
    <label>frag grenade</label>
    <graphicData>
      <texPath>Projectiles/PDWorks_40mmRussian</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
		<projectile>
			<speed>40</speed>
			<damageDef>Bomb</damageDef>
      <!-- Use default damage/armor penetration from explosion def -->
			<explosionRadius>1.1</explosionRadius>
			<preExplosionSpawnThingDef>Filth_RubbleRock</preExplosionSpawnThingDef>
			<preExplosionSpawnChance>0.3</preExplosionSpawnChance>
			<ai_IsIncendiary>false</ai_IsIncendiary>
			<arcHeightFactor>0.55</arcHeightFactor>
			<shadowSize>0.6</shadowSize>
			<explosionDelay>0</explosionDelay>
		</projectile>
	</ThingDef>
	
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>PDWorks_CrudeCompactGrenadeLauncher</defName>
        <label>Crude compact grenade launcher</label>
        <description>A crudely made grenade launcher using an underbarrel grenade launcher as a foundation, nonetheless it is still effective. Where it lacks in accuracy - it makes up in range, compactness, and fire rate.\nBest used as a sidearm, unless you fancy going up close with a grenade launcher.</description>

        <graphicData>
            <texPath>Weapons/PDWorks_RGM40Kastet</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_Rifle</soundInteract>
        <weaponClasses>
            <li>RangedHeavy</li>
        </weaponClasses>
        <statBases>
            <WorkToMake>20000</WorkToMake>
            <Mass>2.5</Mass>
            <AccuracyTouch>0.7</AccuracyTouch>
            <AccuracyShort>0.6</AccuracyShort>
            <AccuracyMedium>0.25</AccuracyMedium>
            <AccuracyLong>0.15</AccuracyLong>
            <RangedWeapon_Cooldown>2.7</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>40</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <recipeMaker>
			<recipeUsers>
				<li>TableMachining</li>
			</recipeUsers>
			<researchPrerequisite>Machining</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>436</displayPriority>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>CZAPDWorks_Bullet_GrenadeLauncher</defaultProjectile>
                <warmupTime>2</warmupTime>
                <range>23.9</range>
				<forcedMissRadius>0.5</forcedMissRadius>
				<soundCast>Shot_IncendiaryLauncher</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>5</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
            </li>
        </verbs>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>10</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalshTwo</def>
				<drawSize>(0.8,0.8)</drawSize>
				<offsets>
					<li>(0.48,0)</li>
				</offsets>
			</li>
		</modExtensions>
    </ThingDef>
	
