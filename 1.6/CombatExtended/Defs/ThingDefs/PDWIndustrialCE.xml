<Defs>

    <!-- Multi-Caliber/Calibre PDW / Gepard -->
    <ThingDef ParentName="BaseHumanMakeableGun">
		<defName>PDWorks_MultiCalPDW</defName>
		<label>Gepard PDW</label>
		<description>An exotic industrial-era PDW sharing some design familiarity with an antiquated service rifle, capable of firing a wide range of ammunition without the need to change any parts.\n\n Often issued as a weapon to aircrews and vehicle crews alike, as the option of scavenging any pistol ammunition off the enemy gives it high utility in emergency situations.</description>
		
		<graphicData>
			<texPath>Weapons/PDWorks_Gepard</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>30000</WorkToMake>
			<Mass>2.35</Mass>
			<Bulk>3.8</Bulk>
			<ShotSpread>0.15</ShotSpread>
			<SwayFactor>1.1</SwayFactor>
			<SightsEfficiency>1.00</SightsEfficiency>
			<RangedWeapon_Cooldown>0.37</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>35</Steel>
			<WoodLog>5</WoodLog>
			<Chemfuel>5</Chemfuel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>2.01</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_9x18mmMakarov_FMJ</defaultProjectile>
				<burstShotCount>6</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<warmupTime>0.9</warmupTime>
				<range>37</range>
				<soundCast>Shot_MachinePistol</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<weaponTags>
			<li>IndustrialGunAdvanced</li>
			<li>CE_AI_AssaultWeapon</li>
			<li>CE_SMG</li>
			<li>CE_OneHandedWeapon</li>
		</weaponTags>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>40</magazineSize>
				<reloadTime>3.0</reloadTime>
				<ammoSet>AmmoSet_9mmGepard</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>true</aiUseBurstMode>
				<aiAimMode>Snapshot</aiAimMode>
				<aimedBurstShotCount>3</aimedBurstShotCount>
			</li>
		</comps>
		<recipeMaker>
			<researchPrerequisite>GasOperation</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>handle</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>5</power>
				<cooldownTime>2.02</cooldownTime>
				<armorPenetrationBlunt>1.630</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>muzzle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.55</cooldownTime>
				<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
			</li>
		</tools>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<DrawOffset>0.05,0</DrawOffset>
			</li>
			<li Class="MuzzleFlash.MuzzleFlashProps"  MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.8,0.8)</drawSize>
				<offsets>
					<li>(0.53,0.09)</li>
				</offsets>
			</li>
		</modExtensions>
	</ThingDef>
	
